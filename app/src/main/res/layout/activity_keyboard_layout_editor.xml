<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/kb_editor_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp">

        <ImageView
            android:id="@+id/kb_editor_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_baseline_arrow_back_24"
            android:tint="#1a1a1a"
            android:contentDescription="@string/back_to_keyboard" />

        <TextView
            android:id="@+id/kb_editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/keyboard_layout_editor"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/kb_editor_reload"
            style="?android:attr/buttonBarNeutralButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/keyboard_editor_reload" />

        <Button
            android:id="@+id/kb_editor_save"
            style="?android:attr/buttonBarNeutralButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/save" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#e0e0e0" />

    <!-- 操作提示 -->
    <TextView
        android:id="@+id/kb_editor_hint_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textSize="12sp"
        android:textColor="#888888"
        android:text="@string/keyboard_editor_hint" />

    <!-- 真实键盘预览：高度与真实输入法键盘一致（屏高的 keyboardHeightPercent） -->
    <FrameLayout
        android:id="@+id/kb_editor_preview"
        android:layout_width="match_parent"
        android:layout_height="0px"
        android:clipToPadding="false" />

</LinearLayout>